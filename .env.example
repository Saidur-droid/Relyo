# Required production key names for Relyo's deployed Vercel configuration.
# Relyo reads active assignments in this root file as the R1 environment contract.
# Values MUST stay blank in Git. Configure real values only in the provider.
DATABASE_URL=
RELYO_CREDENTIAL_ENCRYPTION_KEY=
RELYO_PASSPORT_SIGNING_PRIVATE_KEY_B64=
VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=

# Required for the current production identity-only OAuth installation:
# OAuth establishes the connection; this server-only token supplies read access.
VERCEL_READ_TOKEN=

# Optional settings have safe code defaults and are NOT required assertions:
# RELYO_CREDENTIAL_ENCRYPTION_KEY_ID defaults to provider-credential-v1.
# VERCEL_OAUTH_SCOPE defaults to openid profile offline_access.
# Neither provider credentials nor any of the keys above may use NEXT_PUBLIC_.
